{
  "name": "@oihai/dsh-harness-trace",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "持续监听并记录本地 Harness 调用 LLM 的全过程：完整提示词（用户输入 + DSH/插件注入）、技能加载、工具调用与命令执行、本地文件读写、联网搜索抓取。按「轮次 → 步骤」依时间汇总为高可读 Markdown，落在会话对应工作区内，序号加时间命名。内置审阅页与可调配置。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "images/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oihai/dsh-harness-trace.git"
  },
  "homepage": "https://github.com/oihai/dsh-harness-trace#readme",
  "bugs": {
    "url": "https://github.com/oihai/dsh-harness-trace/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "trace",
    "llm",
    "prompt",
    "observability"
  ],
  "license": "MIT"
}
